NODE_ENV=development
PORT=8080
ATLASDB_URL=mongodb://127.0.0.1:27017/wanderlust
# Generate locally with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET=
# Production requires all CLOUD_* settings unless UPLOADS_ENABLED=false explicitly.
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
UPLOADS_ENABLED=false
# Trusted reverse-proxy IPs/CIDRs only. Leave blank for direct connections.
TRUST_PROXY=
SESSION_MAX_AGE_MS=604800000
AUTH_WINDOW_MS=900000
LOGIN_LIMIT=10
SIGNUP_LIMIT=5
DB_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
