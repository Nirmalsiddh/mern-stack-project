<% layout('/layouts/boilerplate.ejs') %>
<section class="error-state" aria-labelledby="error-heading">
    <span class="state-icon" aria-hidden="true">!</span>
    <p class="eyebrow">Let's find a way forward</p>
    <h1 id="error-heading">Something needs a second look.</h1>
    <p role="alert">
        <%= message %>
    </p>
    <a class="button" href="/listings">Back to exploring <svg class="icon" aria-hidden="true">
            <use href="#icon-arrow"/>
        </svg>
    </a>
</section>
