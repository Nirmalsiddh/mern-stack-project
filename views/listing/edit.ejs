<% layout('/layouts/boilerplate.ejs') %>
<div class="listing-form-layout">
    <a class="back-link" href="/listings/<%= listing._id %>">← Back to your listing</a>
    <header class="form-heading">
        <p class="eyebrow">A little refresh</p>
        <h1>Edit your space.</h1>
        <p>Keep the details of your haven up to date.</p>
    </header>
    <form method="post" action="/listings/<%= listing._id %>?_method=put" novalidate class="needs-validation listing-form" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <%- include('form-fields.ejs', { draft: listing, editing: true }) %>
        <div class="form-actions">
            <a class="button button-secondary" href="/listings/<%= listing._id %>">Cancel</a>
            <button type="submit" class="button">Save changes <svg class="icon" aria-hidden="true">
                    <use href="#icon-arrow"/>
                </svg>
            </button>
        </div>
    </form>
</div>
