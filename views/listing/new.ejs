<% layout('/layouts/boilerplate.ejs') %>
<div class="listing-form-layout">
    <a class="back-link" href="/listings">← Back to exploring</a>
    <header class="form-heading">
        <p class="eyebrow">Open the door to somewhere new</p>
        <h1>Share your space.</h1>
        <p>Tell travelers what makes your place feel special.</p>
    </header>
    <form method="post" action="/listings" novalidate class="needs-validation listing-form" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <%- include('form-fields.ejs', { draft: { title: '', description: '', price: '', country: '', location: '', filters: 'all' }, editing: false }) %>
        <div class="form-actions">
            <a class="button button-secondary" href="/listings">Cancel</a>
            <button type="submit" class="button">Create listing <svg class="icon" aria-hidden="true">
                    <use href="#icon-arrow"/>
                </svg>
            </button>
        </div>
    </form>
</div>
