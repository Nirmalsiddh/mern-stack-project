<% layout('/layouts/boilerplate.ejs');
const term = typeof searchTerm === 'string' ? searchTerm : '';
const active = typeof activeCategory === 'undefined' ? 'all' : activeCategory;
const icons = { all: 'grid', trending: 'flame', rooms: 'bed', 'iconic cities': 'city', mountains: 'mountain', castles: 'castle', 'amazing pools': 'pool', camping: 'tent', farms: 'farm', arctic: 'snow', domes: 'dome', boats: 'boat' };
%>
<section class="discovery-hero" aria-labelledby="discovery-title">
    <div class="hero-copy">
        <p class="eyebrow">
            <span class="eyebrow-line">
            </span> A place for your next chapter</p>
        <h1 id="discovery-title">Find your kind<br>of <em>somewhere.</em>
        </h1>
        <p class="hero-description">City hideaways. Quieter corners. Discover a place that feels a little more like you.</p>
        <a class="button hero-button" href="#stays">Explore the stays <svg class="icon" aria-hidden="true">
                <use href="#icon-arrow"/>
            </svg>
        </a>
    </div>
    <div class="hero-visual">
        <img src="https://images.unsplash.com/photo-1449158743715-0a90ebb6d2d8?auto=format&amp;fit=crop&amp;w=1200&amp;q=80" data-fallback="/images/stay-placeholder.svg" width="1200" height="800" alt="A quiet courtyard surrounded by greenery" fetchpriority="high">
        <div class="hero-caption">
            <span class="caption-spark" aria-hidden="true">✳</span>
            <span>A change of scenery.<br>
                <strong>A little room to breathe.</strong>
            </span>
        </div>
    </div>
</section>
<section id="stays" class="discovery-section" aria-labelledby="stays-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Your next stay starts here</p>
            <h2 id="stays-title">
                <%= term ? 'Stays in ' + term : active && active !== 'all' ? (categories.find(c => c.value === active)?.label || 'Explore stays') : 'Good places. Great possibilities.' %>
            </h2>
        </div>
        <p class="result-count">
            <%= typeof pagination !== 'undefined' ? pagination.total : allListings.length %> <%= (typeof pagination !== 'undefined' ? pagination.total : allListings.length) === 1 ? 'stay' : 'stays' %> to explore</p>
    </div>
    <nav class="category-filters" aria-label="Accommodation categories">
        <% for (const category of categories) { %>
            <a class="category-filter <%= active === category.value ? 'is-active' : '' %>" href="<%= typeof categoryUrl === 'function' ? categoryUrl(category.value) : '/listings?filter=' + encodeURIComponent(category.value) %>" <%- active === category.value ? 'aria-current="page"' : '' %>>
                <svg class="icon" aria-hidden="true">
                    <use href="#icon-<%= icons[category.value] || 'home' %>"/>
                </svg>
                <span>
                    <%= category.label %>
                </span>
            </a>
        <% } %>
    </nav>
    <% if (typeof sortOptions !== 'undefined') { %>
        <form class="sort-controls" action="/listings" method="get">
            <% if (term) { %><input type="hidden" name="country" value="<%= term %>"><% } %>
            <% if (active && active !== 'all') { %><input type="hidden" name="filter" value="<%= active %>"><% } %>
            <input type="hidden" name="pageSize" value="<%= pageSize %>">
            <label for="sort">Sort stays</label><select class="form-select" id="sort" name="sort"><% for (const option of sortOptions) { %><option value="<%= option.value %>" <%= sort === option.value ? 'selected' : '' %>><%= option.label %></option><% } %></select><button class="button button-secondary" type="submit">Apply sort</button>
        </form>
    <% } %>
    <div class="discovery-toolbar">
        <span>Find a place worth coming back to.</span>
        <label class="tax-toggle" for="flexSwitchCheckDefault">
            <input type="checkbox" id="flexSwitchCheckDefault" role="switch"> Show tax note</label>
    </div>
    <% if (!allListings.length) { %>
        <div class="empty-state">
            <span class="state-icon">
                <svg class="icon" aria-hidden="true">
                    <use href="#icon-search"/>
                </svg>
            </span>
            <h3>No listings found<%= term ? ' for ' + term : '' %>.</h3>
            <p>Try another country or explore all categories to find your next haven.</p>
            <a class="button button-secondary" href="/listings">Explore all stays</a>
        </div>
    <% } else { %>
        <%- include('cards.ejs') %>
    <% } %>
</section>

<% if (typeof pagination !== 'undefined') { %><%- include('../includes/pagination.ejs') %><% } %>
