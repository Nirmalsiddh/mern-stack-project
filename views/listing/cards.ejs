        <div class="listing-grid">
            <% for (const listing of allListings) { %>
                <article class="stay-card">
                    <a class="stay-link" href="/listings/<%= listing._id %>">
                        <div class="stay-photo">
                            <img src="<%= listing.image?.url || '/images/stay-placeholder.svg' %>" data-fallback="/images/stay-placeholder.svg" width="640" height="480" loading="lazy" decoding="async" alt="<%= listing.image?.url ? listing.title : 'Photo unavailable for ' + listing.title %>">
                            <% if (listing.country) { %>
                                <span class="photo-label">
                                    <%= listing.country %>
                                </span>
                            <% } %>
                        </div>
                        <div class="stay-heading">
                            <h3>
                                <%= listing.title %>
                            </h3>
                            <svg class="icon card-arrow" aria-hidden="true">
                                <use href="#icon-arrow"/>
                            </svg>
                        </div>
                        <p class="stay-location">
                            <svg class="icon" aria-hidden="true">
                                <use href="#icon-pin"/>
                            </svg>
                            <%= [listing.location, listing.country].filter(Boolean).join(', ') || 'Location not provided' %>
                        </p>
                        <%- include('../includes/rating-summary.ejs', { listing }) %>
                        <p class="stay-price">
                            <% if (Number.isFinite(listing.price)) { %>
                                <strong>₹<%= listing.price.toLocaleString('en-IN') %>
                                </strong>
                                <span> / night</span>
                            <% } else { %>
                                <span>Price unavailable</span>
                            <% } %>
                            <span class="tax-info"> +18% GST</span>
                        </p>
                    </a>
                    <% if (typeof collectionMode !== 'undefined' && collectionMode === 'owned') { %>
                        <div class="account-actions"><a class="button button-secondary button-small" href="/listings/<%= listing._id %>/edit">Edit listing</a><form action="/listings/<%= listing._id %>?_method=DELETE" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger button-small">Delete listing</button></form></div>
                    <% } else if (typeof collectionMode !== 'undefined' && collectionMode === 'saved') { %>
                        <form class="account-actions" action="/saved/<%= listing._id %>?_method=DELETE" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-secondary button-small" aria-label="Remove <%= listing.title %> from saved listings">Remove saved stay</button></form>
                    <% } %>
                </article>
            <% } %>
        </div>
