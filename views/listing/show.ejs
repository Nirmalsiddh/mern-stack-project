<% layout('/layouts/boilerplate.ejs'); const reviews = listing.reviews || []; %>
<article class="listing-detail">
    <a class="back-link" href="/listings">← Back to all stays</a>
    <header class="detail-heading">
        <p class="eyebrow">A place to call your own, for a while</p>
        <h1>
            <%= listing.title %>
        </h1>
        <p class="detail-location">
            <svg class="icon" aria-hidden="true">
                <use href="#icon-pin"/>
            </svg>
            <%= [listing.location, listing.country].filter(Boolean).join(', ') || 'Location not provided' %>
        </p>
    </header>
    <div class="detail-photo">
        <img src="<%= listing.image?.url || '/images/stay-placeholder.svg' %>" data-fallback="/images/stay-placeholder.svg" alt="<%= listing.image?.url ? listing.title : 'Photo unavailable for ' + listing.title %>" width="1200" height="720" fetchpriority="high">
    </div>
    <div class="detail-grid">
        <div class="detail-content">
            <section class="description-section" aria-labelledby="about-heading">
                <p class="eyebrow">Settle in</p>
                <h2 id="about-heading">About this space</h2>
                <p class="listing-description">
                    <%= listing.description || 'The host has not added a description yet.' %>
                </p>
            </section>
            <div class="host-block">
                <span class="avatar" aria-hidden="true">
                    <%= listing.owner?.username?.charAt(0).toUpperCase() || '?' %>
                </span>
                <div>
                    <span class="muted small-label">Listed by</span>
                    <strong>
                        <%= listing.owner ? listing.owner.username : 'Unavailable user' %>
                    </strong>
                </div>
            </div>
            <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
                <section class="owner-actions" aria-label="Manage your listing">
                    <span>This is your listing</span>
                    <a class="button button-secondary button-small" href="/listings/<%= listing._id %>/edit">Edit listing</a>
                    <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="button button-danger button-small">Delete listing</button>
                    </form>
                </section>
            <% } %>
            <section class="reviews-section" aria-labelledby="reviews-heading">
                <div class="section-heading">
                    <h2 id="reviews-heading">Guest reviews</h2>
                    <span class="count-badge">
                        <%= reviews.length %>
                    </span>
                </div>
                <% if (!reviews.length) { %>
                    <div class="review-empty">
                        <h3>A fresh perspective starts with you.</h3>
                        <p>No reviews yet. Share your experience of this space.</p>
                    </div>
                <% } %>
                <div class="review-grid">
                    <% for (const review of reviews) { %>
                        <article class="review-card">
                            <header>
                                <span class="avatar avatar-small" aria-hidden="true">
                                    <%= review.author?.username?.charAt(0).toUpperCase() || '?' %>
                                </span>
                                <div>
                                    <h3>
                                        <%= review.author ? review.author.username : 'Unavailable user' %>
                                    </h3>
                                    <% if (review.createdAt) { %>
                                        <time datetime="<%= new Date(review.createdAt).toISOString() %>">
                                            <%= new Date(review.createdAt).toLocaleDateString('en-IN', { month: 'short', year: 'numeric' }) %>
                                        </time>
                                    <% } %>
                                </div>
                                <span class="review-rating">
                                    <span aria-hidden="true">★</span> <%= review.rating %>
                                    <span class="muted"> / 5</span>
                                </span>
                            </header>
                            <p>
                                <%= review.comment %>
                            </p>
                            <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                                <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button class="text-button" type="submit">Delete review</button>
                                </form>
                            <% } %>
                        </article>
                    <% } %>
                </div>
                <% if (currUser) { %>
                    <div class="review-form-panel">
                        <h3>How was your stay?</h3>
                        <p class="muted">Your experience can help someone find their haven.</p>
                        <form method="post" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <fieldset class="rating-fieldset">
                                <legend>Your rating</legend>
                                <div class="rating-options">
                                    <% for (let rating = 1; rating <= 5; rating++) { %>
                                        <label class="rating-option" for="rating-<%= rating %>">
                                            <input type="radio" id="rating-<%= rating %>" name="review[rating]" value="<%= rating %>" <%= rating === 1 ? 'checked' : '' %> required>
                                            <span>
                                                <%= rating %> <%= rating === 1 ? 'star' : 'stars' %>
                                            </span>
                                        </label>
                                    <% } %>
                                </div>
                            </fieldset>
                            <div class="field">
                                <label for="comment">Your review <span aria-hidden="true">*</span>
                                </label>
                                <textarea name="review[comment]" id="comment" maxlength="2000" rows="4" class="form-control" aria-describedby="comment-help comment-error" placeholder="What would you like other guests to know?" required></textarea>
                                <p class="field-help" id="comment-help">Up to 2,000 characters. Please keep it helpful and respectful.</p>
                                <div class="invalid-feedback" id="comment-error">Please add a review before submitting.</div>
                            </div>
                            <button class="button" type="submit">Share your review</button>
                        </form>
                    </div>
                <% } else { %>
                    <div class="review-signin">
                        <h3>Have a story to share?</h3>
                        <p>Log in to leave a review of this space.</p>
                        <a class="button button-secondary" href="/login">Log in to review</a>
                    </div>
                <% } %>
            </section>
        </div>
        <aside class="price-panel" aria-label="Listing price">
            <p class="eyebrow">Your next change of scenery</p>
            <p class="detail-price">
                <% if (Number.isFinite(listing.price)) { %>
                    <strong>₹<%= listing.price.toLocaleString('en-IN') %>
                    </strong>
                    <span> / night</span>
                <% } else { %>Price unavailable<% } %>
            </p>
            <hr>
            <div class="price-location">
                <svg class="icon" aria-hidden="true">
                    <use href="#icon-pin"/>
                </svg>
                <span>
                    <%= listing.location || 'Location not provided' %>
                    <small>
                        <%= listing.country || '' %>
                    </small>
                </span>
            </div>
            <p class="price-note">A little space for a new perspective.</p>
        </aside>
    </div>
</article>
