<nav class="pagination-controls" aria-label="Listing pages">
    <% if (pagination.previous) { %><a class="button button-secondary" rel="prev" href="<%= pagination.previous %>">Previous</a><% } else { %><span aria-disabled="true">Previous</span><% } %>
    <span aria-current="page">Page <%= pagination.page %> of <%= pagination.pages %></span>
    <% if (pagination.next) { %><a class="button button-secondary" rel="next" href="<%= pagination.next %>">Next</a><% } else { %><span aria-disabled="true">Next</span><% } %>
</nav>
