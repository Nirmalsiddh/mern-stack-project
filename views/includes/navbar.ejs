<header class="site-header">
    <div class="header-inner">
        <a class="brand" href="/listings" aria-label="HavenHub home">
            <span class="brand-mark">
                <svg class="icon" aria-hidden="true">
                    <use href="#icon-home"/>
                </svg>
            </span>
            <span>HavenHub<span class="brand-dot">.</span>
            </span>
        </a>
        <details class="mobile-navigation">
            <summary>Menu <span aria-hidden="true">☰</span>
            </summary>
            <nav aria-label="Mobile navigation">
                <%- include('navigation-links.ejs') %>
            </nav>
        </details>
        <form class="site-search" role="search" action="/listings/search" method="get">
            <label class="visually-hidden" for="site-search">Search by destination country</label>
            <svg class="icon" aria-hidden="true">
                <use href="#icon-search"/>
            </svg>
            <input type="search" name="country" maxlength="100" id="site-search" value="<%= typeof searchTerm === 'string' ? searchTerm : '' %>" placeholder="Where would you like to go?" autocomplete="off">
            <button type="submit" aria-label="Search stays">Search</button>
        </form>
        <nav class="desktop-navigation" aria-label="Main navigation">
            <%- include('navigation-links.ejs') %>
        </nav>
    </div>
</header>
