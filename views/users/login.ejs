<% layout('/layouts/boilerplate.ejs') %>
<section class="auth-layout" aria-labelledby="auth-title">
    <div class="auth-story">
        <span class="eyebrow">A familiar feeling</span>
        <p class="auth-story-title">New places.<br>Your kind of people.</p>
        <p>Discover a new corner of the world. Share a space or a story. Make yourself at home.</p>
        <span class="story-decoration" aria-hidden="true">✳</span>
    </div>
    <div class="auth-form">
        <p class="eyebrow">Make yourself at home</p>
        <h1 id="auth-title">Welcome back.</h1>
        <p class="form-intro">Log in to your HavenHub account.</p>
        <form method="post" action="/login" class="needs-validation" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" maxlength="128" autocomplete="username" class="form-control" aria-describedby="username-error" required>
                <div class="invalid-feedback" id="username-error">Please enter your username.</div>
            </div>
            <div class="field">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" maxlength="128" autocomplete="current-password" class="form-control" aria-describedby="password-error" required>
                <div class="invalid-feedback" id="password-error">Please enter your password.</div>
            </div>
            <button type="submit" class="button button-full">Log in <svg class="icon" aria-hidden="true">
                    <use href="#icon-arrow"/>
                </svg>
            </button>
        </form>
        <p class="auth-alternate">New around here? <a href="/signup">Join HavenHub</a>
        </p>
    </div>
</section>
