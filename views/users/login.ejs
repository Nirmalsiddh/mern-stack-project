<% layout("/layouts/boilerplate.ejs") %>
    <div class="row mt-3">
        <div class="col-6 offset-3">
            <h2>Login</h2>
            <br>
            <form method="post" action="/login" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input type="text" id="username" placeholder="Enter Username" name="username" class="form-control" required>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                    <div class="invalid-feedback">
                        Please enter username
                    </div>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" id="email" placeholder="Enter EmailId" name="email" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" id="password" placeholder="Enter Password" name="password" class="form-control" required>
                </div>
                <button class="btn btn-outline-success">Login</button>
            </form>
        </div>
    </div>